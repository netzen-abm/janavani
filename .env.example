# Janavani environment template
# NEVER put real credentials in this file or commit a populated .env.
# Configure production secrets in the deployment platform's secret store.

# ============================================================
# Canonical production runtime
# ============================================================
JANAVANI_RUNTIME_MODE=production
JANAVANI_CASE_REPOSITORY_PROVIDER=postgres
JANAVANI_ARTIFACT_REPOSITORY_PROVIDER=postgres
JANAVANI_EVIDENCE_REPOSITORY_PROVIDER=postgres
JANAVANI_ARTIFACT_BLOB_PROVIDER=s3
JANAVANI_POSTGRES_DSN=
JANAVANI_ARTIFACT_S3_BUCKET=
JANAVANI_ARTIFACT_S3_ENDPOINT_URL=
JANAVANI_ARTIFACT_S3_PREFIX=artifacts

# ============================================================
# Canonical Web/API interface credentials
# Configure only on services that need them.
# ============================================================
WEB_INTERFACE_TOKEN=
JANAVANI_INTERFACE_TOKENS=
ADMIN_INTERFACE_SECRET_TOKEN=
JANAVANI_AI_BASE_URL=
JANAVANI_INTERNAL_API_URL=
JANAVANI_INTERNAL_FEEDBACK_URL=

# ============================================================
# AI provider credentials
# Configure only on the runtime that directly invokes the provider.
# ============================================================
OPENROUTER_API_KEY=
HF_TOKEN=

# ============================================================
# Supabase integration
# Configure only on services that actually use Supabase.
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================================
# Telegram — independent surface
# Do NOT add this to the Web/API service merely because Janavani
# supports Telegram.
# ============================================================
TELEGRAM_BOT_TOKEN=

# ============================================================
# Runtime infrastructure
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=10000
LOG_LEVEL=INFO

# ============================================================
# Local/development artifact storage
# ============================================================
JANAVANI_ARTIFACT_BLOB_ROOT=/tmp/janavani-artifacts

# ============================================================
# Integration-test-only
# ============================================================
JANAVANI_POSTGRES_TEST_DSN=

# ============================================================
# Future / capability-specific integrations
# ============================================================
NOSTR_PRIVATE_KEY_HEX=
NOSTR_RELAYS=wss://relay.damus.io
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001
WEB3_RPC=
CHAIN_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
GAS_PRICE_GWEI=5
NYM_SOCKS=socks5h://127.0.0.1:1080
FREENET_FPROXY=http://127.0.0.1:8888
