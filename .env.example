# ============================================
# Required
# ============================================

TELEGRAM_BOT_TOKEN=

SUPABASE_URL=

SUPABASE_ANON_KEY=

PORT=10000

# ============================================
# Optional Integrations
# ============================================

# De-centralized & privacy integrations (optional)

# Nostr
NOSTR_PRIVATE_KEY_HEX=
NOSTR_RELAYS=wss://relay.damus.io

# IPFS
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001

# Blockchain
WEB3_RPC=
CHAIN_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
GAS_PRICE_GWEI=5

# Nym (local SOCKS5 provided by a configured nym-client)
NYM_SOCKS=socks5h://127.0.0.1:1080

# Freenet (if you run a Freenet node locally)
FREENET_FPROXY=http://127.0.0.1:8888
