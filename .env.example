# Janavani environment template
# NEVER put real credentials in this file or commit a populated .env.
# Configure production secrets in the deployment platform's secret store.

# ============================================================
# Canonical production runtime
# ============================================================
JANAVANI_RUNTIME_MODE=production
JANAVANI_CASE_REPOSITORY_PROVIDER=postgres
JANAVANI_ARTIFACT_REPOSITORY_PROVIDER=postgres
JANAVANI_EVIDENCE_REPOSITORY_PROVIDER=postgres
JANAVANI_AUTHORITY_REPOSITORY_PROVIDER=postgres
JANAVANI_CONSENT_REPOSITORY_PROVIDER=postgres
JANAVANI_EXTERNAL_IDENTITY_LINKS_REPOSITORY_PROVIDER=postgres
JANAVANI_ARTIFACT_BLOB_PROVIDER=s3
JANAVANI_POSTGRES_DSN=
# Production identity mapping must use a dedicated least-privilege database role.
JANAVANI_IDENTITY_LINKS_DSN=
JANAVANI_ARTIFACT_S3_BUCKET=
JANAVANI_ARTIFACT_S3_ENDPOINT_URL=
JANAVANI_ARTIFACT_S3_PREFIX=artifacts

# ============================================================
# Private reusable citizen document structures
# Configure only after the table/RLS migration and dedicated least-privilege role are ready.
# The runtime fails closed if durable storage is not configured; do not enable memory in production.
# ============================================================
JANAVANI_CITIZEN_DOCUMENT_FORMAT_REPOSITORY_PROVIDER=postgres
JANAVANI_CITIZEN_DOCUMENT_FORMAT_DSN=
JANAVANI_CITIZEN_DOCUMENT_FORMAT_ALLOW_EPHEMERAL=false

# ============================================================
# Canonical Web/API interface credentials
# Configure only on services that need them.
# ============================================================
WEB_INTERFACE_TOKEN=
JANAVANI_INTERFACE_TOKENS=
ADMIN_INTERFACE_SECRET_TOKEN=
JANAVANI_AI_BASE_URL=
JANAVANI_INTERNAL_API_URL=
# Canonical API base URL consumed by Dynamic Web and WebApp adapters.
JANAVANI_WEB_API_URL=http://127.0.0.1:8000
JANAVANI_INTERNAL_FEEDBACK_URL=

# ============================================================
# Trusted identity gateway boundary
# Server-side only. Never expose to browsers, Telegram clients,
# or other untrusted surfaces.
# ============================================================
JANAVANI_IDENTITY_ASSERTION_SECRET=
JANAVANI_IDENTITY_ASSERTION_ISSUER=janavani-identity
JANAVANI_IDENTITY_ASSERTION_AUDIENCE=janavani-api
# Required by authenticated HTTP routes; shared Redis store for atomic single-use assertions.
# Configure on every Web/API replica in the server-side secret store; no in-memory fallback.
JANAVANI_IDENTITY_REPLAY_REDIS_URL=

# ============================================================
# AI provider credentials
# Configure only on the runtime that directly invokes the provider.
# ============================================================
OPENROUTER_API_KEY=
LEGAL_DRAFTING_MODEL=meta-llama/llama-3.1-70b-instruct
HF_TOKEN=

# ============================================================
# Telegram — independent surface
# Do NOT add this to the Web/API service merely because Janavani
# supports Telegram.
# ============================================================
TELEGRAM_BOT_TOKEN=

# Webhook mode only. The standalone polling entry point is disabled.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://<your-public-webhook-host>/telegram/webhook
JANAVANI_TELEGRAM_INBOX_DSN=
# One or more Fernet URL-safe base64 keys, comma-separated for rotation.
JANAVANI_TELEGRAM_INBOX_ENCRYPTION_KEYS=

# ============================================================
# Runtime infrastructure
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=10000
LOG_LEVEL=INFO

# ============================================================
# Local/development artifact storage
# ============================================================
JANAVANI_ARTIFACT_BLOB_ROOT=/tmp/janavani-artifacts

# ============================================================
# Integration-test-only
# ============================================================
JANAVANI_POSTGRES_TEST_DSN=

# ============================================================
# Future / capability-specific integrations
# ============================================================
NOSTR_PRIVATE_KEY_HEX=
NOSTR_RELAYS=wss://relay.damus.io
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001
WEB3_RPC=
CHAIN_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
GAS_PRICE_GWEI=5
NYM_SOCKS=socks5h://127.0.0.1:1080
FREENET_FPROXY=http://127.0.0.1:8888
